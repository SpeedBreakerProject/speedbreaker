diff --git a/XenonUtils/ppc_context.h b/XenonUtils/ppc_context.h
index 31a86cd..745e1c0 100644
--- a/XenonUtils/ppc_context.h
+++ b/XenonUtils/ppc_context.h
@@ -682,6 +682,20 @@ inline simde__m128i simde_mm_vctsxs(simde__m128 src1)
     return simde_mm_andnot_si128(simde_mm_castps_si128(xmm2), simde_mm_castps_si128(dest));
 }
 
+// vctuxs: float -> uint32 with saturation. NaN and negatives give 0, values
+// >= 2^32 give 0xFFFFFFFF, everything else truncates toward zero.
+inline simde__m128i simde_mm_vctuxs(simde__m128 src)
+{
+    simde__m128 ordered = simde_mm_cmpord_ps(src, src);
+    simde__m128 clamped = simde_mm_and_ps(simde_mm_max_ps(src, simde_mm_setzero_ps()), ordered);
+    simde__m128 two31 = simde_mm_set1_ps(2147483648.0f);
+    simde__m128i big = simde_mm_castps_si128(simde_mm_cmpge_ps(clamped, two31));
+    simde__m128 adjusted = simde_mm_sub_ps(clamped, simde_mm_and_ps(simde_mm_castsi128_ps(big), two31));
+    simde__m128i result = simde_mm_xor_si128(simde_mm_cvttps_epi32(adjusted), simde_mm_and_si128(big, simde_mm_set1_epi32(INT_MIN)));
+    simde__m128i over = simde_mm_castps_si128(simde_mm_cmpge_ps(clamped, simde_mm_set1_ps(4294967296.0f)));
+    return simde_mm_or_si128(result, over);
+}
+
 inline simde__m128i simde_mm_vsr(simde__m128i a, simde__m128i b)
 {
     b = simde_mm_srli_epi64(simde_mm_slli_epi64(b, 61), 61);
