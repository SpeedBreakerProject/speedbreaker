// SpeedBreaker's Windows resources. GPL-3.0-or-later (see COPYING).
// The icon (scripts/windows/make_ico.py), the version block, and the
// manifest (linked with /MANIFEST:NO, so this is the only one).
#include <winver.h>

1 ICON "speedbreaker.ico"

// CREATEPROCESS_MANIFEST_RESOURCE_ID (1), RT_MANIFEST (24).
1 24 "speedbreaker.manifest"

VS_VERSION_INFO VERSIONINFO
FILEVERSION 0,0,0,0
PRODUCTVERSION 0,0,0,0
FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
FILEFLAGS 0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", "SpeedBreaker"
            VALUE "FileDescription", "SpeedBreaker"
            VALUE "FileVersion", "0.0.0.0"
            VALUE "InternalName", "SpeedBreaker"
            VALUE "LegalCopyright", "GPL-3.0-or-later"
            VALUE "OriginalFilename", "SpeedBreaker.exe"
            VALUE "ProductName", "SpeedBreaker"
            VALUE "ProductVersion", "0.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
